# Copy this file to `.env` and fill values for local development

# Use either DATABASE_URL or individual DB_* variables
# Example Postgres URL:
# DATABASE_URL=postgres://postgres:password@localhost:5432/plshey
# Example MySQL URL:
# DATABASE_URL=mysql://root:@localhost:3306/plshey
DATABASE_URL=

# Optional dialect when using DB_* variables
DB_DIALECT=postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=plshey
DB_USER=postgres
DB_PASS=

SESSION_SECRET=change_this_to_a_long_random_value

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
