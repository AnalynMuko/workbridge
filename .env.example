# Copy this file to `.env` and fill values for local development

# Use either DATABASE_URL or individual DB_* variables
# Example DATABASE_URL: mysql://user:password@host:3306/dbname
DATABASE_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=plshey
DB_USER=root
DB_PASS=

SESSION_SECRET=change_this_to_a_long_random_value

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
