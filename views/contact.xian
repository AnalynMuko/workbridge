{{> head }}
<body class="bg-white">
  <nav class="sticky top-0 z-50 bg-white shadow-md">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex-shrink-0">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 to-red-600 bg-clip-text text-transparent">WorkBridge</h1>
      </div>
      <div class="flex gap-4">
        <a href="/" class="text-gray-700 hover:text-red-600">Home</a>
        <a href="/about" class="text-gray-700 hover:text-red-600">About</a>
        <a href="/login" class="bg-gradient-to-r from-yellow-500 to-red-600 text-white px-4 py-2 rounded-lg">Login</a>
      </div>
    </div>
  </nav>

  <main class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-4xl font-bold text-center text-gray-900 mb-6">Get In Touch</h2>
      <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl mb-4">✉️</div>
          <h4 class="text-xl font-bold mb-2">Email</h4>
          <p class="text-gray-600">support@workbridge.com</p>
        </div>
        <div>
          <div class="text-4xl mb-4">📱</div>
          <h4 class="text-xl font-bold mb-2">Phone</h4>
          <p class="text-gray-600">+1 (555) 123-4567</p>
        </div>
        <div>
          <div class="text-4xl mb-4">📍</div>
          <h4 class="text-xl font-bold mb-2">Address</h4>
          <p class="text-gray-600">San Francisco, CA 94105</p>
        </div>
      </div>
    </div>
  </main>

  

</body>
