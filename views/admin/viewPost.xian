{{> head }}
<body class="bg-white">
  <div class="container mx-auto px-6 py-8 max-w-3xl">
    <h1 class="text-2xl font-bold mb-4">Post by {{post.posterName}}</h1>
    <div class="p-6 border rounded-lg bg-gray-50">
      <p class="text-gray-800 whitespace-pre-line">{{post.content}}</p>
      {{#if post.image}}
        <div class="mt-4">
          <img src="/uploads/{{post.image}}" alt="post image" class="max-w-full rounded" />
        </div>
      {{/if}}
      <div class="mt-4 text-sm text-gray-600">Created: {{post.createdAt}}</div>
    </div>
    <div class="mt-6 flex gap-3">
      {{#if post.removed}}
        <form method="POST" action="/admin/posts/{{post.id}}/restore" onsubmit="return confirm('Restore this post?');">
          <button class="bg-green-600 text-white px-4 py-2 rounded">Restore Post</button>
        </form>
      {{else}}
        <form method="POST" action="/admin/posts/{{post.id}}/delete" onsubmit="return confirm('Delete this post?');">
          <button class="bg-red-600 text-white px-4 py-2 rounded">Delete Post</button>
        </form>
      {{/if}}
      <a href="/admin/posts" class="text-gray-600 px-4 py-2">Back</a>
    </div>
  </div>
  
</body>
</html>