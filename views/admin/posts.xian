{{> head }}
<body class="bg-white">
  <div class="container mx-auto px-6 py-8">
    <h1 class="text-2xl font-bold mb-4">Review Posts</h1>
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr>
          <th class="border px-2 py-1 text-left">ID</th>
          <th class="border px-2 py-1 text-left">Author</th>
          <th class="border px-2 py-1 text-left">Content</th>
          <th class="border px-2 py-1">Created</th>
          <th class="border px-2 py-1">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each posts}}
          <tr>
            <td class="border px-2 py-1">{{this.id}}</td>
            <td class="border px-2 py-1">{{this.posterName}}</td>
            <td class="border px-2 py-1">{{this.content}}</td>
            <td class="border px-2 py-1">{{this.createdAt}}</td>
            <td class="border px-2 py-1 text-center">
              <a href="/admin/posts/{{this.id}}" class="text-blue-600 mr-2">View</a>
              {{#if this.removed}}
                <form method="POST" action="/admin/posts/{{this.id}}/restore" style="display:inline" onsubmit="return confirm('Restore this post?');">
                  <button class="text-green-600">Restore</button>
                </form>
              {{else}}
                <form method="POST" action="/admin/posts/{{this.id}}/delete" style="display:inline" onsubmit="return confirm('Delete this post?');">
                  <button class="text-red-600">Delete</button>
                </form>
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    <div class="mt-6">
      <a href="/admin" class="text-gray-600">Back to admin</a>
    </div>
  </div>
  
</body>
</html>