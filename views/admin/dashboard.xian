{{> head }}
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow border-b">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 bg-clip-text text-transparent">WorkBridge</h1>
        <span class="px-3 py-1 text-xs font-semibold bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-full">Admin Panel</span>
      </div>
      <div>
        <a href="/" class="text-gray-700 hover:text-red-600 mr-4">View Site</a>
        <a href="/admin/logout" class="bg-red-500 text-white px-3 py-2 rounded-md">Logout</a>
      </div>
    </div>
  </nav>

  <header class="py-10">
    <div class="container mx-auto px-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-4xl font-extrabold text-gray-900">Administrator Dashboard</h2>
          <p class="text-gray-600 mt-1">Overview of platform activity and quick actions</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/admin/users" class="bg-white border border-red-200 text-red-600 px-4 py-2 rounded-lg shadow-sm">Manage Users</a>
          <a href="/admin/moderation" class="bg-white border border-purple-200 text-purple-600 px-4 py-2 rounded-lg shadow-sm">Moderation</a>
          <a href="/admin/jobs" class="bg-white border border-indigo-200 text-indigo-600 px-4 py-2 rounded-lg shadow-sm">Jobs</a>
        </div>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-6 pb-12">
    <!-- Stats -->
    <section class="grid md:grid-cols-5 gap-6 -mt-8">
      <div class="p-6 bg-gradient-to-br from-yellow-100 to-yellow-50 rounded-2xl shadow-lg border border-yellow-200">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold text-yellow-800">Total Users</div>
          <svg class="w-8 h-8 text-yellow-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-gray-900 mt-4">{{stats.usersCount}}</div>
        <div class="text-xs text-yellow-700 mt-2">Registered accounts</div>
      </div>

      <div class="p-6 bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-lg border border-red-200">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold text-red-800">Active Jobs</div>
          <svg class="w-8 h-8 text-red-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 01-2-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-gray-900 mt-4">{{stats.jobsCount}}</div>
        <div class="text-xs text-red-700 mt-2">Job postings</div>
      </div>

      <div class="p-6 bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-2xl shadow-lg border border-indigo-200">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold text-indigo-800">Social Posts</div>
          <svg class="w-8 h-8 text-indigo-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-gray-900 mt-4">{{stats.postsCount}}</div>
        <div class="text-xs text-indigo-700 mt-2">Community posts</div>
      </div>

      <div class="p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-lg border border-blue-200">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold text-blue-800">Messages</div>
          <svg class="w-8 h-8 text-blue-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-gray-900 mt-4">{{stats.messagesCount}}</div>
        <div class="text-xs text-blue-700 mt-2">Platform messages</div>
      </div>

      <div class="p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl shadow-lg border border-green-200">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold text-green-800">Notifications</div>
          <svg class="w-8 h-8 text-green-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-gray-900 mt-4">{{stats.notificationsCount}}</div>
        <div class="text-xs text-green-700 mt-2">Sent notifications</div>
      </div>
    </section>

    <!-- Main content: quick actions and recent activity -->
    <section class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="md:col-span-2 bg-white rounded-2xl shadow p-6 border border-gray-100">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-bold">Quick Actions</h3>
          <div class="text-sm text-gray-500">Execute common admin tasks</div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/admin/users" class="p-4 bg-gradient-to-r from-yellow-50 to-yellow-100 border border-yellow-200 rounded-lg hover:shadow-lg transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-yellow-200 flex items-center justify-center">👥</div>
            <div>
              <div class="font-semibold">Manage Users</div>
              <div class="text-xs text-gray-500">View, promote, or remove accounts</div>
            </div>
          </a>

          <a href="/admin/moderation" class="p-4 bg-gradient-to-r from-red-50 to-red-100 border border-red-200 rounded-lg hover:shadow-lg transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-red-200 flex items-center justify-center">🛡️</div>
            <div>
              <div class="font-semibold">Moderation</div>
              <div class="text-xs text-gray-500">Review posts and jobs</div>
            </div>
          </a>

          <a href="/admin/jobs" class="p-4 bg-gradient-to-r from-indigo-50 to-indigo-100 border border-indigo-200 rounded-lg hover:shadow-lg transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-indigo-200 flex items-center justify-center">💼</div>
            <div>
              <div class="font-semibold">Manage Jobs</div>
              <div class="text-xs text-gray-500">Approve, change status, or remove</div>
            </div>
          </a>

          <a href="/messages" class="p-4 bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 rounded-lg hover:shadow-lg transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-blue-200 flex items-center justify-center">✉️</div>
            <div>
              <div class="font-semibold">Messages</div>
              <div class="text-xs text-gray-500">Inspect conversations</div>
            </div>
          </a>
        </div>
      </div>

      <aside class="bg-white rounded-2xl shadow p-6 border border-gray-100">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold">Recent Activity</h3>
          <a href="/admin/audit" class="text-sm text-gray-500">View all</a>
        </div>

        {{#if recentLogs}}
          <ul class="space-y-3">
            {{#each recentLogs}}
              <li class="text-sm">
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs text-gray-600">{{this.actorName.[0]}}</div>
                  <div>
                    <div class="font-semibold text-gray-800">{{this.action}}</div>
                    <div class="text-xs text-gray-500">{{this.createdAt}}</div>
                  </div>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="text-sm text-gray-500">No recent activity</p>
        {{/if}}
      </aside>
    </section>
  </main>

  

  <style>
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px);} to { opacity:1; transform: none;} }
    section, main { animation: fadeInUp 0.45s ease-out; }
  </style>
</body>
</html>