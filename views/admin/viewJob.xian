{{> head }}
<body class="bg-white">
  <div class="container mx-auto px-6 py-8 max-w-3xl">
    <h1 class="text-2xl font-bold mb-4">Job: {{job.title}}</h1>
    <div class="p-6 border rounded-lg bg-gray-50">
      <div class="text-sm text-gray-600 mb-2">By: {{job.posterName}}</div>
      <h2 class="text-xl font-semibold mb-2">{{job.position}}</h2>
      <p class="text-gray-800 whitespace-pre-line">{{job.description}}</p>
      <div class="mt-4 text-sm text-gray-600">Budget: {{job.currency}} {{job.budget}}</div>
      <div class="mt-2 text-sm text-gray-600">Deadline: {{job.deadline}}</div>
      <div class="mt-2 text-sm text-gray-600">Status: <strong>{{job.status}}</strong></div>
    </div>

    <div class="mt-6 flex gap-3">
      <form method="POST" action="/admin/jobs/{{job.id}}/status">
        <select name="status" class="border px-2 py-1 rounded">
          <option value="active" {{#ifEquals job.status 'active'}}selected{{/ifEquals}}>Active</option>
          <option value="inactive" {{#ifEquals job.status 'inactive'}}selected{{/ifEquals}}>Inactive</option>
          <option value="removed" {{#ifEquals job.status 'removed'}}selected{{/ifEquals}}>Removed</option>
        </select>
        <button class="bg-blue-600 text-white px-4 py-2 rounded ml-2">Update</button>
      </form>
      {{#if job.removed}}
        <form method="POST" action="/admin/jobs/{{job.id}}/restore" onsubmit="return confirm('Restore this job posting?');">
          <button class="bg-green-600 text-white px-4 py-2 rounded">Restore Job</button>
        </form>
      {{else}}
        <form method="POST" action="/admin/jobs/{{job.id}}/delete" onsubmit="return confirm('Delete this job posting? This action cannot be undone.');">
          <button class="bg-red-600 text-white px-4 py-2 rounded">Delete Job</button>
        </form>
      {{/if}}
      <a href="/admin/jobs" class="text-gray-600 px-4 py-2">Back</a>
    </div>
  </div>
  
</body>
</html>