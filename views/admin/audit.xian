{{> head }}
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow border-b">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 bg-clip-text text-transparent">WorkBridge</h1>
        <span class="px-3 py-1 text-xs font-semibold bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-full">Admin Panel</span>
      </div>
      <div>
        <a href="/admin" class="text-gray-700 hover:text-red-600 mr-4">Dashboard</a>
        <a href="/admin/logout" class="bg-red-500 text-white px-3 py-2 rounded-md">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container mx-auto px-6 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Audit Logs</h2>
        <p class="text-sm text-gray-500">Track administrative actions and system events.</p>
      </div>
      <div class="flex items-center gap-3">
        <form method="GET" action="/admin/audit" class="flex items-center gap-2">
          <input name="q" value="{{q}}" placeholder="Search action or target" class="border px-3 py-2 rounded-lg" />
          <select name="action" class="border px-2 py-2 rounded-lg">
            <option value="">All actions</option>
            <option value="promote_user" {{#ifEquals actionFilter 'promote_user'}}selected{{/ifEquals}}>Promote User</option>
            <option value="demote_user" {{#ifEquals actionFilter 'demote_user'}}selected{{/ifEquals}}>Demote User</option>
            <option value="soft_delete_post" {{#ifEquals actionFilter 'soft_delete_post'}}selected{{/ifEquals}}>Soft Delete Post</option>
            <option value="restore_post" {{#ifEquals actionFilter 'restore_post'}}selected{{/ifEquals}}>Restore Post</option>
            <option value="soft_delete_job" {{#ifEquals actionFilter 'soft_delete_job'}}selected{{/ifEquals}}>Soft Delete Job</option>
          </select>
          <button class="px-3 py-2 bg-red-600 text-white rounded-lg">Search</button>
        </form>
      </div>
    </div>

    {{#if logs.length}}
      <div class="space-y-4">
        {{#each logs}}
          <div class="bg-white rounded-2xl shadow p-4 border border-gray-100">
            <div class="flex items-start justify-between">
              <div>
                <div class="text-sm text-gray-500">{{this.createdAt}}</div>
                <div class="mt-1 font-semibold text-gray-900">{{this.action}}</div>
                <div class="text-xs text-gray-600">Actor: {{this.actorName}} • Target: {{this.targetType}} #{{this.targetId}}</div>
              </div>
              <div class="text-right text-xs text-gray-500">ID: {{this.id}}</div>
            </div>
            <div class="mt-3 text-sm text-gray-700 bg-gray-50 p-3 rounded">
              <pre class="whitespace-pre-wrap">{{json this.details}}</pre>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="bg-white rounded-2xl shadow p-6 border border-gray-100 text-gray-600">No audit logs found.</div>
    {{/if}}

    {{#if pagination}}
      <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-600">Page {{pagination.page}} of {{pagination.totalPages}} — {{pagination.total}} results</div>
        <div class="flex items-center gap-2">
          {{#ifGt pagination.page 1}}
            <a href="?page={{dec pagination.page}}{{#if q}}&q={{q}}{{/if}}{{#if actionFilter}}&action={{actionFilter}}{{/if}}" class="px-3 py-1 border rounded">Previous</a>
          {{else}}
            <span class="px-3 py-1 border rounded text-gray-400">Previous</span>
          {{/ifGt}}
          <span class="text-sm text-gray-600 px-2">Page {{pagination.page}}</span>
          {{#ifGt pagination.totalPages pagination.page}}
            <a href="?page={{inc pagination.page}}{{#if q}}&q={{q}}{{/if}}{{#if actionFilter}}&action={{actionFilter}}{{/if}}" class="px-3 py-1 bg-red-600 text-white rounded">Next</a>
          {{else}}
            <span class="px-3 py-1 border rounded text-gray-400">Next</span>
          {{/ifGt}}
        </div>
      </div>
    {{/if}}

    <div class="mt-6 text-sm text-gray-500">
      <a href="/admin" class="mr-4">Back to admin</a>
    </div>
  </main>

  
</body>
</html>
