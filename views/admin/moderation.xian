{{> head }}
<body class="bg-white">
  <div class="container mx-auto px-6 py-8">
    <h1 class="text-2xl font-bold mb-4">Moderation Center</h1>
    <p class="text-gray-600 mb-6">Choose which area you'd like to moderate.</p>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="p-6 border rounded-lg bg-gray-50">
        <h3 class="font-semibold text-lg mb-2">Social Posts</h3>
        <p class="text-sm text-gray-600 mb-2">Review, remove, or restore community posts.</p>
        {{#if stats}}
          <div class="text-sm text-gray-700 mb-3">Total: <strong>{{stats.totalPosts}}</strong> — Removed: <strong class="text-red-600">{{stats.removedPosts}}</strong></div>
        {{/if}}
        <a href="/admin/reviewposts" class="text-purple-600 font-semibold">Open Posts Moderation →</a>
      </div>

      <div class="p-6 border rounded-lg bg-gray-50">
        <h3 class="font-semibold text-lg mb-2">Job Postings</h3>
        <p class="text-sm text-gray-600 mb-2">Review job listings; change status, remove, or restore.</p>
        {{#if stats}}
          <div class="text-sm text-gray-700 mb-3">Total: <strong>{{stats.totalJobs}}</strong> — Removed: <strong class="text-red-600">{{stats.removedJobs}}</strong></div>
        {{/if}}
        <a href="/admin/jobs" class="text-red-600 font-semibold">Open Jobs Moderation →</a>
      </div>
    </div>

    <div class="mt-6">
      <a href="/admin" class="text-gray-600">Back to admin</a>
    </div>
  </div>
  
</body>
</html>
