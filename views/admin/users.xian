{{> head }}
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <!-- Top nav (consistent with admin panel) -->
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow border-b">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 bg-clip-text text-transparent">WorkBridge</h1>
        <span class="px-3 py-1 text-xs font-semibold bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-full">Admin Panel</span>
      </div>
      <div>
        <a href="/admin" class="text-gray-700 hover:text-red-600 mr-4">Dashboard</a>
        <a href="/admin/logout" class="bg-red-500 text-white px-3 py-2 rounded-md">Logout</a>
      </div>
    </div>
  </nav>

  <section class="py-12">
    <div class="container mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Manage Users</h2>
          <p class="text-gray-600 mt-1">View and manage registered accounts.</p>
        </div>
        <div>
          <a href="/admin" class="inline-block bg-white border border-red-200 text-red-600 px-5 py-2 rounded-lg font-semibold shadow-sm">Back to Admin</a>
        </div>
      </div>

      {{#if success_msg}}
        <div class="p-4 mb-6 bg-green-50 border border-green-200 text-green-800 rounded">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
        <div class="p-4 mb-6 bg-red-50 border border-red-200 text-red-800 rounded">{{error_msg}}</div>
      {{/if}}

      <div class="grid md:grid-cols-3 gap-6">
        {{#each users}}
          <div class="p-6 bg-white rounded-2xl shadow hover:shadow-2xl transition-all border border-gray-100">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-gradient-to-r from-yellow-400 to-red-500 text-white flex items-center justify-center font-bold text-lg">{{this.name.[0]}}</div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-gray-900">{{this.name}}</div>
                    <div class="text-sm text-gray-500">{{this.email}}</div>
                  </div>
                  {{#if this.isAdmin}}
                    <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full">Admin</span>
                  {{/if}}
                </div>
                <div class="text-xs text-gray-400 mt-2">Joined: {{this.createdAt}}</div>
              </div>
            </div>

            <div class="mt-4 flex items-center gap-3">
              <a href="/admin/users/{{this.id}}" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg">Open</a>
              <form method="POST" action="/admin/users/{{this.id}}/delete" onsubmit="return confirm('Delete this user?');">
                <button class="bg-red-600 text-white px-4 py-2 rounded-lg">Delete</button>
              </form>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  </section>

  
</body>
</html>