{{> head }}
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow border-b">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 bg-clip-text text-transparent">WorkBridge</h1>
        <span class="px-3 py-1 text-xs font-semibold bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-full">Admin Panel</span>
      </div>
      <div>
        <a href="/admin/users" class="text-gray-700 hover:text-red-600 mr-4">Back to Users</a>
        <a href="/admin/logout" class="bg-red-500 text-white px-3 py-2 rounded-md">Logout</a>
      </div>
    </div>
  </nav>

  <section class="py-12">
    <div class="container mx-auto px-6">
      {{#if success_msg}}
        <div class="p-4 mb-6 bg-green-50 border border-green-200 text-green-800 rounded">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
        <div class="p-4 mb-6 bg-red-50 border border-red-200 text-red-800 rounded">{{error_msg}}</div>
      {{/if}}

      <div class="bg-white rounded-2xl shadow p-6 border border-gray-100 max-w-3xl mx-auto">
        <div class="flex items-start gap-6">
          <div class="w-24 h-24 rounded-full bg-gradient-to-r from-yellow-400 to-red-500 text-white flex items-center justify-center font-bold text-2xl">{{user.name.[0]}}</div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-gray-900">{{user.name}}</h2>
            <p class="text-sm text-gray-500">{{user.email}}</p>
            <div class="mt-3 text-sm text-gray-600">
              <p><strong>Account ID:</strong> {{user.id}}</p>
              <p><strong>Admin:</strong> {{#if user.isAdmin}}Yes{{else}}No{{/if}}</p>
              <p><strong>Created:</strong> {{user.createdAt}}</p>
            </div>
          </div>
        </div>

        {{#if profile}}
          <div class="mt-6">
            <h3 class="font-semibold text-gray-800">Profile</h3>
            {{#if profile.avatar}}
              <img src="/uploads/{{profile.avatar}}" alt="avatar" class="w-28 h-28 rounded mt-3" />
            {{else}}
              <p class="text-sm text-gray-500 mt-2">No profile avatar</p>
            {{/if}}
          </div>
        {{/if}}

        <div class="mt-6 flex gap-3">
          <form method="POST" action="/admin/users/{{user.id}}/role">
            <input type="hidden" name="isAdmin" value="true" />
            <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-lg">Set as Admin</button>
          </form>

          <form method="POST" action="/admin/users/{{user.id}}/role">
            <input type="hidden" name="isAdmin" value="false" />
            <button type="submit" class="bg-yellow-600 text-white px-4 py-2 rounded-lg">Set as User</button>
          </form>

          <form method="POST" action="/admin/users/{{user.id}}/delete" onsubmit="return confirm('Delete this user?');">
            <button class="bg-red-600 text-white px-4 py-2 rounded-lg">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  
</body>
</html>
