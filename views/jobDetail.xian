{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-6 py-10">
    <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-md p-6">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{{job.title}}</h1>
          {{#if job.position}}<div class="text-sm text-gray-700">Position: {{job.position}}</div>{{/if}}
          <div class="text-sm text-gray-600 mt-2">Posted by: <span class="font-semibold">{{posterName}}</span></div>
        </div>
        <div class="text-right">
          <p class="text-2xl font-bold text-red-600">{{#if job.budget}}{{job.budget}}{{else}}—{{/if}}</p>
          <p class="text-sm text-gray-600">{{job.currency}}</p>
        </div>
      </div>

      <div class="mb-6 text-gray-800">
        <p>{{job.description}}</p>
      </div>

      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">Deadline: {{job.deadline}}</p>
        </div>
        <form method="POST" action="/jobs/{{job.id}}/apply">
          <button type="submit" class="px-6 py-2 bg-gradient-to-r from-yellow-500 to-red-600 text-white rounded-lg font-semibold">Apply</button>
        </form>
      </div>
    </div>
    </div>

    <div class="container mx-auto px-6 py-4">
      <!-- Proposal submission (for logged-in freelancers who are not the job owner) -->
      {{#if currentUserId}}
        {{#unlessEquals currentUserId job.userId}}
          {{#ifEquals job.status 'active'}}
           
                <form method="POST" action="/jobs/{{job.id}}/proposals" enctype="multipart/form-data">
                {{#if job.requirements}}
                  <div class="mb-3">
                    <h4 class="text-sm font-medium">Required documents</h4>
                    <p class="text-xs text-gray-500">Please upload the documents requested by the employer.</p>
                    {{#each (jsonParse job.requirements)}}
                      <div class="mt-2">
                        <label class="text-sm">{{this}}</label>
                        <input type="file" name="requirements" class="w-full mt-1" />
                      </div>
                    {{/each}}
                  </div>
                {{/if}}
                <div class="mb-3">
                  <label class="text-sm">Proposal Message</label>
                  <textarea name="message" class="w-full px-3 py-2 border rounded" rows="4"></textarea>
                </div>
                <div class="text-right">
                  <button class="px-4 py-2 bg-red-600 text-white rounded">Submit Proposal</button>
                </div>
                </form>
            </div>
          {{/ifEquals}}
        {{/unlessEquals}}
      {{/if}}

      <!-- Proposals list for job owner -->
      {{#if currentUserId}}
        {{#ifEquals currentUserId job.userId}}
          <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-md p-6 mb-6">
            <h3 class="text-lg font-semibold mb-3">Proposals ({{proposals.length}})</h3>
            {{#if proposals.length}}
              <div class="space-y-4">
                {{#each proposals}}
                  <div class="border rounded p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <div class="font-semibold">Freelancer ID: {{this.freelancerId}}</div>
                        <div class="text-sm text-gray-600">Bid: {{#if this.bid}}{{this.bid}}{{else}}—{{/if}} • Delivery: {{#if this.deliveryDays}}{{this.deliveryDays}} days{{else}}—{{/if}}</div>
                      </div>
                      <div class="text-sm text-gray-600">Status: <strong>{{this.status}}</strong></div>
                    </div>
                    {{#if this.message}}<p class="mt-3 text-gray-700">{{this.message}}</p>{{/if}}
                    {{#if this.files.length}}
                      <div class="mt-3 flex gap-2">
                        {{#each this.files}}
                          <a href="/uploads/proposals/{{this.filename}}" target="_blank" class="px-2 py-1 border rounded text-sm">{{this.originalname}}</a>
                        {{/each}}
                      </div>
                    {{/if}}
                    {{#if this.requirementFiles}}
                      <div class="mt-2">
                        <h4 class="text-sm font-medium">Submitted Documents</h4>
                        <div class="flex gap-2 mt-2">
                          {{#each (jsonParse this.requirementFiles)}}
                            <a href="/uploads/proposals/{{this.filename}}" target="_blank" class="px-2 py-1 border rounded text-sm bg-gray-50">{{this.originalname}}</a>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}
                    <div class="mt-3 flex gap-2">
                      {{#ifEquals this.status 'Pending'}}
                        <form method="POST" action="/proposals/{{this.id}}/accept">
                          <button class="px-3 py-1 bg-green-600 text-white rounded text-sm">Accept</button>
                        </form>
                        <form method="POST" action="/proposals/{{this.id}}/reject">
                          <button class="px-3 py-1 bg-gray-200 text-sm rounded">Reject</button>
                        </form>
                      {{/ifEquals}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="text-sm text-gray-500">No proposals yet.</div>
            {{/if}}
          </div>
        {{/ifEquals}}
      {{/if}}
    </div>

  </div>

</body>
</html>
