<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WorkBridge - Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <!-- Navbar -->
  <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-lg border-b border-gray-200">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="relative">
          <h1 class="text-2xl font-bold bg-gradient-to-r from-yellow-500 via-orange-500 to-red-600 bg-clip-text text-transparent animate-gradient">WorkBridge</h1>
          <div class="absolute -bottom-1 left-0 w-full h-0.5 bg-gradient-to-r from-yellow-500 to-red-600"></div>
        </div>
        <span class="px-3 py-1 text-xs font-semibold bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-full shadow-sm">Admin Panel</span>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-sm text-gray-700 flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-yellow-400 to-red-500 flex items-center justify-center text-white font-semibold text-xs">
            {{#if currentUser}}{{currentUser.name.[0]}}{{else}}A{{/if}}
          </div>
          <span class="hidden md:block">Welcome, <strong>{{#if currentUser}}{{currentUser.name}}{{else}}Admin User{{/if}}</strong></span>
        </div>
        <a href="/admin/logout" onclick="return confirm('Are you sure you want to log out?');" class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-4 py-2 rounded-lg font-medium shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Top Jobs Chart (placed after Quick Actions) -->
  <section class="py-8">
    <div class="container mx-auto px-6">
      <div class="bg-white rounded-2xl shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-2xl font-semibold">Top Jobs by Proposals</h3>
          <div class="text-sm text-gray-500">Most applied jobs</div>
        </div>
        <div style="height:260px">
          <canvas id="topJobsChart" height="240"></canvas>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
    <div class="container mx-auto px-6 relative">
      <div class="md:flex md:items-center md:justify-between">
        <div class="animate-slide-in-left">
          <h2 class="text-5xl font-bold text-gray-900 mb-2">Administrator Dashboard</h2>
          <p class="text-gray-600 text-lg">Real-time overview of platform activity and management tools.</p>
        </div>
        <div class="mt-6 md:mt-0 animate-slide-in-right">
          <a href="/admin/users" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-red-600 px-6 py-3 rounded-xl font-semibold border-2 border-red-200 hover:border-red-300 shadow-md hover:shadow-xl transition-all duration-300 transform hover:scale-105">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            Manage Users
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 -mt-8">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-5 gap-6">
        <div class="stat-card p-6 bg-gradient-to-br from-yellow-100 to-yellow-50 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-yellow-200">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-yellow-800">Total Users</div>
            <svg class="w-8 h-8 text-yellow-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-gray-900 count-up">{{stats.usersCount}}</div>
          <div class="text-xs text-yellow-700 mt-2">Registered accounts</div>
        </div>

        <div class="stat-card p-6 bg-gradient-to-br from-red-50 to-red-100 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-red-200" style="animation-delay: 0.1s">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-red-800">Active Jobs</div>
            <svg class="w-8 h-8 text-red-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-gray-900 count-up">{{stats.jobsCount}}</div>
          <div class="text-xs text-red-700 mt-2">Job postings</div>
        </div>

        <div class="stat-card p-6 bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-indigo-200" style="animation-delay: 0.2s">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-indigo-800">Social Posts</div>
            <svg class="w-8 h-8 text-indigo-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-gray-900 count-up">{{stats.postsCount}}</div>
          <div class="text-xs text-indigo-700 mt-2">Community posts</div>
        </div>

        <div class="stat-card p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-blue-200" style="animation-delay: 0.3s">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-blue-800">Messages</div>
            <svg class="w-8 h-8 text-blue-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-gray-900 count-up">{{stats.messagesCount}}</div>
          <div class="text-xs text-blue-700 mt-2">Platform messages</div>
        </div>

        <div class="stat-card p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-green-200" style="animation-delay: 0.4s">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-green-800">Notifications</div>
            <svg class="w-8 h-8 text-green-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
          </div>
          <div class="text-4xl font-bold text-gray-900 count-up">{{stats.notificationsCount}}</div>
          <div class="text-xs text-green-700 mt-2">Sent notifications</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Jobs Graph -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-6">
      <div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl border-2 border-gray-200 p-8 shadow-lg">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h3 class="text-3xl font-bold text-gray-900">Top Job Postings</h3>
            <p class="text-gray-600 mt-1">Most active job listings by applications</p>
          </div>
          <div class="px-4 py-2 bg-gradient-to-r from-yellow-500 to-red-500 text-white rounded-lg text-sm font-semibold shadow-md">
            Last 30 Days
          </div>
        </div>
        
        <div class="space-y-4" id="topJobsContainer">
          <!-- Jobs will be rendered here -->
        </div>
      </div>
    </div>
  </section>

  <!-- Actions / Controls -->
  <section class="py-12 bg-transparent">
    <div class="container mx-auto px-6">
      <h3 class="text-3xl font-bold mb-8 text-gray-900">Quick Actions</h3>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="action-card group p-8 bg-white rounded-2xl border-2 border-gray-200 hover:border-blue-400 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-xl mb-2 text-gray-900">User Management</h4>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">View and remove users, grant admin rights, or investigate accounts for policy violations.</p>
          <a href="/admin/users" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all duration-300">
            Open Users
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="action-card group p-8 bg-white rounded-2xl border-2 border-gray-200 hover:border-purple-400 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1" style="animation-delay: 0.1s">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-xl mb-2 text-gray-900">Jobs & Posts</h4>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">Moderate job postings and social content, remove problematic or inappropriate material.</p>
          <a href="/admin/moderation" class="inline-flex items-center gap-2 text-purple-600 font-semibold hover:gap-3 transition-all duration-300">
            Open Moderation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="action-card group p-8 bg-white rounded-2xl border-2 border-gray-200 hover:border-emerald-400 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1" style="animation-delay: 0.2s">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-xl mb-2 text-gray-900">Messages & Notifications</h4>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">Inspect message flow and notification delivery across the entire platform.</p>
          <a href="/messages" class="inline-flex items-center gap-2 text-emerald-600 font-semibold hover:gap-3 transition-all duration-300">
            Open Messages
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Render top jobs server-side into the container -->
  {{#if topJobs}}
    <script>
      document.addEventListener('DOMContentLoaded', function(){
        const container = document.getElementById('topJobsContainer');
        if (!container) return;
        container.innerHTML = `
          {{#each topJobs}}
            <div class="top-job group relative bg-white rounded-xl border border-gray-200 hover:border-blue-400 p-5 transition-all duration-300 hover:shadow-lg" data-proposals="{{this.proposalsCount}}" data-title="{{this.title}}" style="animation: fadeInUp 0.6s ease-out {{@index}}0.1s both;">
              <div class="flex items-center justify-between mb-3">
                <div class="flex-1">
                  <h4 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition-colors">{{this.title}}</h4>
                  <p class="text-sm text-gray-500">{{this.company}} • {{this.location}}</p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-blue-600">{{this.proposalsCount}}</div>
                  <div class="text-xs text-gray-500">applications</div>
                </div>
              </div>
              <div class="relative w-full h-3 bg-gray-100 rounded-full overflow-hidden">
                <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-yellow-500 via-orange-500 to-red-500 rounded-full job-bar" style="--target-width: 0%;"></div>
              </div>
            </div>
          {{/each}}
        `;
      });
    </script>
  {{else}}
    <script>document.addEventListener('DOMContentLoaded', function(){ const c = document.getElementById('topJobsContainer'); if (c) c.innerHTML = '<div class="text-sm text-gray-500">No top jobs data available.</div>'; });</script>
  {{/if}}

  <style>
    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideIn {
      from {
        width: 0%;
      }
      to {
        width: var(--target-width);
      }
    }

    .animate-slide-in-left {
      animation: slideInLeft 0.6s ease-out;
    }

    .animate-slide-in-right {
      animation: slideInRight 0.6s ease-out;
    }

    .stat-card {
      animation: fadeInUp 0.6s ease-out;
    }

    .action-card {
      animation: fadeInUp 0.6s ease-out;
    }

    .job-bar {
      animation: slideIn 1s ease-out both;
    }

    .bg-grid-pattern {
      background-image: radial-gradient(circle, #e5e7eb 1px, transparent 1px);
      background-size: 20px 20px;
    }

    @keyframes gradient {
      0%, 100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    .animate-gradient {
      background-size: 200% auto;
      animation: gradient 3s ease infinite;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    (function(){
      try {
        const container = document.getElementById('topJobsContainer');
        const ctx = document.getElementById('topJobsChart');
        if (!ctx) return;
        // Build labels/data from rendered top job items to avoid embedding raw JSON
        const items = container ? Array.from(container.querySelectorAll('.top-job')) : [];
        const labels = items.map(it => it.dataset.title || it.querySelector('h4')?.innerText || 'Job');
        const data = items.map(it => parseInt(it.dataset.proposals || (it.querySelector('.text-2xl')?.innerText || '0')) || 0);
        new Chart(ctx.getContext('2d'), {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Proposals',
              data: data,
              backgroundColor: labels.map(()=> 'rgba(59,130,246,0.85)'),
              borderColor: labels.map(()=> 'rgba(37,99,235,1)'),
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { grid: { display: false } },
              y: { beginAtZero: true, grid: { color: '#f3f4f6' } }
            },
            plugins: { legend: { display: false } }
          }
        });
      } catch (err) { console.error('topJobsChart init error', err); }
    })();
  </script>
</body>
</html>