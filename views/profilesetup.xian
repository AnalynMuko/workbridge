{{> head}}
<body class="bg-gradient-to-r from-yellow-50 via-yellow-100 to-red-50 min-h-screen flex flex-col justify-center items-center">

  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl p-10 border border-gray-100">
    <h1 class="text-3xl font-bold text-center mb-6 bg-gradient-to-r from-yellow-500 to-red-600 bg-clip-text text-transparent">
      Complete Your Profile
    </h1>
    <p class="text-center text-gray-600 mb-8">Please provide your personal and professional details to complete your WorkBridge profile.</p>

    <form method="POST" action="/profile-setup" enctype="multipart/form-data" class="space-y-6">
      <!-- Personal Information -->
      <div>
        <h2 class="text-xl font-semibold text-gray-800 mb-3">Personal Information</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <input type="text" name="fullname" placeholder="Full Name" required value="{{#if profile}}{{profile.fullname}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">
          <input type="date" name="birthdate" required value="{{#if profile}}{{profile.birthdate}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">
          <select name="gender" required class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">
            <option value="">Select Gender</option>
            <option {{#ifEquals profile.gender 'Male'}}selected{{/ifEquals}}>Male</option>
            <option {{#ifEquals profile.gender 'Female'}}selected{{/ifEquals}}>Female</option>
            <option {{#ifEquals profile.gender 'Other'}}selected{{/ifEquals}}>Other</option>
          </select>
          <input type="text" name="contact_number" placeholder="Contact Number" required value="{{#if profile}}{{profile.contactNumber}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">
          <input type="text" name="address" placeholder="Address" required value="{{#if profile}}{{profile.address}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">
        </div>
      </div>

      <!-- Professional Information -->
      <div>
        <h2 class="text-xl font-semibold text-gray-800 mb-3">Professional Information</h2>
        <input type="text" name="skills" placeholder="Skills (e.g., Web Design, Data Entry)" required value="{{#if profile}}{{profile.skills}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none mb-3">
        <input type="number" name="experience" placeholder="Years of Experience" required value="{{#if profile}}{{profile.experience}}{{/if}}" class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none mb-3">
        <textarea name="bio" placeholder="Write a short bio about yourself..." rows="4" required class="p-3 border rounded-lg w-full focus:ring-2 focus:ring-yellow-500 focus:outline-none">{{#if profile}}{{profile.bio}}{{/if}}</textarea>
      </div>

      <!-- ID Verification -->
      <div>
        <h2 class="text-xl font-semibold text-gray-800 mb-3">Credibility Verification</h2>
        <label class="block text-gray-700 mb-1 font-medium">Upload a Valid ID (e.g., Passport, Driver’s License)</label>
        <input type="file" name="id_proof" accept="image/*" required class="block w-full text-gray-600 border border-gray-300 p-3 rounded-lg cursor-pointer focus:ring-2 focus:ring-yellow-500 focus:outline-none">
      </div>

      <!-- Submit -->
      <button type="submit" class="w-full bg-gradient-to-r from-yellow-500 to-red-600 text-white font-semibold py-3 rounded-lg hover:shadow-xl transform hover:scale-105 transition">
        Save Profile
      </button>
    </form>
  </div>

  <!-- Decorative Circles -->
  <div class="absolute top-10 left-10 w-40 h-40 bg-gradient-to-br from-yellow-400 to-red-500 rounded-full opacity-20 blur-3xl"></div>
  <div class="absolute bottom-10 right-10 w-40 h-40 bg-gradient-to-br from-red-400 to-yellow-500 rounded-full opacity-20 blur-3xl"></div>

 
