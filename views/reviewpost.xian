{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold">Review Community Posts</h1>
        <p class="text-sm text-gray-600">Moderate, warn, restore, or permanently remove posts from the community feed.</p>
      </div>
      <div class="text-right">
        <a href="/admin" class="text-gray-600 hover:underline">← Back to admin</a>
      </div>
    </div>

    {{#if success_msg}}
      <div class="p-4 mb-4 bg-green-50 border border-green-200 text-green-800 rounded">{{success_msg}}</div>
    {{/if}}

    {{#if posts.length}}
      <div class="mb-4 flex items-center justify-between gap-4">
        <form method="POST" action="/admin/posts/bulk" id="bulkForm" class="flex items-center gap-3 w-full">
          <label class="inline-flex items-center gap-2"><input type="checkbox" id="selectAll" /> <span class="text-sm">Select all</span></label>
          <select name="action" class="border px-3 py-1 rounded bg-white">
            <option value="remove">Remove (soft-delete)</option>
            <option value="restore">Restore</option>
            <option value="force-delete">Force Delete (permanent)</option>
          </select>
          <button type="submit" onclick="return confirmBulkAction()" class="px-4 py-1 bg-red-600 text-white rounded shadow">Apply</button>
          <div class="ml-auto text-sm text-gray-700">Total posts: <strong>{{posts.length}}</strong></div>
        </form>
      </div>

      <div class="grid gap-4">
        {{#each posts}}
          <article class="bg-white rounded-xl shadow p-4 border">
            <div class="flex items-start gap-4">
              <div class="flex items-start gap-3">
                <input type="checkbox" name="ids[]" value="{{this.id}}" form="bulkForm" class="post-checkbox mt-2" />
                <div class="w-12 h-12 rounded-full bg-gradient-to-r from-yellow-500 to-red-600 text-white flex items-center justify-center font-bold">{{this.posterName.[0]}}</div>
              </div>

              <div class="flex-1">
                <div class="flex items-start justify-between">
                  <div>
                    <div class="font-semibold text-gray-900">{{this.posterName}}</div>
                    <div class="text-xs text-gray-500">Posted: {{this.createdAt}}</div>
                  </div>
                  <div class="flex items-center gap-2">
                    {{#if this.removed}}<span class="text-sm text-red-600 font-semibold">Removed</span>{{/if}}
                  </div>
                </div>

                <div class="mt-3 text-gray-800 whitespace-pre-line">{{this.content}}</div>

                {{#if this.image}}
                  <div class="mt-3">
                    <img src="/uploads/{{this.image}}" class="max-w-sm rounded shadow-sm" alt="post image" />
                  </div>
                {{/if}}

                <div class="mt-4 flex flex-wrap items-center gap-3">
                  {{#if this.removed}}
                    <form method="POST" action="/admin/posts/{{this.id}}/restore" onsubmit="return confirm('Restore this post?');">
                      <button class="px-3 py-1 bg-green-600 text-white rounded">Restore</button>
                    </form>
                  {{else}}
                    <form method="POST" action="/admin/posts/{{this.id}}/delete" onsubmit="return confirm('Remove (soft-delete) this post?');">
                      <button class="px-3 py-1 bg-yellow-500 text-white rounded">Remove</button>
                    </form>
                  {{/if}}

                  <form method="POST" action="/admin/posts/{{this.id}}/force-delete" onsubmit="return confirm('Permanently delete this post? This cannot be undone.');">
                    <button class="px-3 py-1 bg-red-600 text-white rounded">Force Delete</button>
                  </form>

                  <button type="button" class="px-3 py-1 bg-blue-600 text-white rounded" onclick="toggleWarnForm('{{this.id}}')">Warn User</button>

                  <a href="/admin/posts/{{this.id}}" class="px-3 py-1 border rounded text-sm">View Details</a>
                </div>

                <div id="warn-{{this.id}}" class="mt-3 hidden">
                  <form method="POST" action="/admin/posts/{{this.id}}/warn" onsubmit="return confirm('Send warning to user?');">
                    <label class="block text-sm font-medium text-gray-700">Warning / Feedback</label>
                    <textarea name="message" rows="3" class="mt-1 block w-full border rounded p-2" placeholder="Explain the issue and suggested actions."></textarea>
                    <div class="mt-2 flex gap-2">
                      <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded">Send Warning</button>
                      <button type="button" class="px-3 py-1 bg-gray-200 rounded" onclick="hideWarnForm('{{this.id}}')">Cancel</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <div class="bg-white rounded-xl shadow p-6 text-center">
        <h3 class="text-lg font-semibold text-gray-900">No posts to review</h3>
        <p class="text-sm text-gray-600 mt-2">There are currently no community posts. Users will see their posts on the Browse page.</p>
      </div>
    {{/if}}

  </div>
  

  <script>
    // Guarded DOM interactions
    const selectAllEl = document.getElementById('selectAll');
    if (selectAllEl) {
      selectAllEl.addEventListener('change', function(e){
        const checked = e.target.checked;
        document.querySelectorAll('.post-checkbox').forEach(cb => cb.checked = checked);
      });
    }

    function confirmBulkAction(){
      const actionEl = document.querySelector('select[name="action"]');
      const action = actionEl ? actionEl.value : '';
      if(action === 'force-delete') return confirm('Permanently delete selected posts? This cannot be undone.');
      if(action === 'remove') return confirm('Remove selected posts (soft-delete)?');
      return true;
    }

    function toggleWarnForm(id){
      const el = document.getElementById('warn-' + id);
      if(!el) return;
      el.classList.toggle('hidden');
      if(!el.classList.contains('hidden')){
        const ta = el.querySelector('textarea'); if(ta) ta.focus();
      }
    }
    function hideWarnForm(id){ const el = document.getElementById('warn-' + id); if(!el) return; el.classList.add('hidden'); }
  </script>
</body>
</html>
